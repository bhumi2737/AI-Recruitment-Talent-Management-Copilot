# ==============================================================================
# AI RECRUITMENT & TALENT MANAGEMENT COPILOT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' for local development or enter these keys into
# Streamlit Community Cloud Secrets (st.secrets). DO NOT commit actual secrets to Git!

# ------------------------------------------------------------------------------
# MongoDB Credentials & Database Settings
# ------------------------------------------------------------------------------
# Connection string for remote MongoDB Atlas or local MongoDB instance
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=recruitment_copilot
MONGO_COLLECTION=candidates

# ------------------------------------------------------------------------------
# Groq AI API Key (LLM Question Gen, Interview Evaluation, Whisper Speech-to-Text)
# Obtain a free key at: https://console.groq.com/keys
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here

# ------------------------------------------------------------------------------
# Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Secret key used for JWT token signing (change to a random long string in production)
JWT_SECRET_KEY=your_production_jwt_secret_key_here

# Default bootstrap admin password (used when seeding default admin user)
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# Optional FastAPI Server Configuration (main.py)
# ------------------------------------------------------------------------------
FRONTEND_URL=*
HOST=0.0.0.0
PORT=8000
