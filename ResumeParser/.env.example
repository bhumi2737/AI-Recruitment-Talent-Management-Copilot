# Copy this file to '.env' inside ResumeParser/ or set variables in Streamlit Cloud Secrets.

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGO_DB=recruitment_copilot
MONGO_COLLECTION=candidates

GROQ_API_KEY=gsk_your_groq_api_key_here
JWT_SECRET_KEY=your_production_jwt_secret_key_here
BOOTSTRAP_ADMIN_PASSWORD=your_secure_admin_password_here
